#version 450
// Affine (warped) inter prediction, one invocation per 8x8 block.
//
// Mirrors av2/common/warped_motion.c av2_highbd_warp_affine_c() for the
// single-prediction case (conv_params->is_compound == 0), including the chroma
// projection shifts (subsampling_x / subsampling_y):
//   - project the 8x8 block centre with the affine matrix (64-bit products
//     emulated through imulExtended because MoltenVK has no shaderInt64),
//   - 15x8 horizontal pass with av2_warped_filter, clamped reference reads,
//   - 8x8 vertical pass, then clip_pixel_highbd(sum - (1 << (bd-1)) - (1<<bd)).

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) readonly buffer Ref { uint ref_px[]; };
layout(std430, binding = 1) buffer Pred { uint pred_px[]; };
layout(std430, binding = 2) readonly buffer WarpFilt { int wf[]; };

layout(push_constant) uniform PC {
  uint width;
  uint height;
  uint stride;
  uint p_col;
  uint p_row;
  uint p_width;
  uint p_height;
  uint p_stride;
  uint bd;
  uint round_0;
  int m0;
  int m1;
  int m2;
  int m3;
  int m4;
  int m5;
  int alpha;
  int beta;
  int gamma;
  int delta;
  uint ss_x;
  uint ss_y;
  uint pad0;
} pc;

const int FILTER_BITS = 7;
const int WARPEDMODEL_PREC_BITS = 16;
const int WARPEDDIFF_PREC_BITS = WARPEDMODEL_PREC_BITS - 6;
const int WARPEDPIXEL_PREC_SHIFTS = 64;
const int WARP_PARAM_REDUCE_BITS = 6;

int clampi(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

// 64-bit product as (hi, lo).
void mul64(int a, int b, out int hi, out int lo) {
  int h, l;
  imulExtended(a, b, h, l);
  hi = h;
  lo = l;
}

// Arithmetic right shift of a (hi, lo) pair by one bit.
void shr1(inout int hi, inout int lo) {
  const uint ul = uint(lo);
  lo = int((ul >> 1) | (uint(hi) << 31));
  hi = hi >> 1;
}

void add64(inout int hi, inout int lo, int ah, int al) {
  const uint old = uint(lo);
  uint nl = old + uint(al);
  lo = int(nl);
  hi = hi + ah + (nl < old ? 1 : 0);
}

void main() {
  const int bx = int(gl_WorkGroupID.x);
  const int by = int(gl_WorkGroupID.y);
  const int i0 = int(pc.p_row) + by * 8;
  const int j0 = int(pc.p_col) + bx * 8;

  const int width = int(pc.width);
  const int height = int(pc.height);
  const int stride = int(pc.stride);
  const int bd = int(pc.bd);
  const int reduce_bits_horiz = int(pc.round_0);
  const int reduce_bits_vert = 2 * FILTER_BITS - reduce_bits_horiz;
  const int offset_bits_horiz = bd + FILTER_BITS - 1;
  const int offset_bits_vert = bd + 2 * FILTER_BITS - reduce_bits_horiz;

  // Block centre projected through the affine matrix, in luma coordinates for
  // chroma planes ((j + 4) << ss_x), then shifted back down.
  const int ss_x = int(pc.ss_x);
  const int ss_y = int(pc.ss_y);
  const int src_x = (j0 + 4) << ss_x;
  const int src_y = (i0 + 4) << ss_y;
  int hx, lx, hy, ly, th, tl;
  mul64(pc.m2, src_x, hx, lx);
  mul64(pc.m3, src_y, th, tl);
  add64(hx, lx, th, tl);
  add64(hx, lx, pc.m0 >> 31, pc.m0);
  mul64(pc.m4, src_x, hy, ly);
  mul64(pc.m5, src_y, th, tl);
  add64(hy, ly, th, tl);
  add64(hy, ly, pc.m1 >> 31, pc.m1);

  // (dst_x >> ss_x) >> 16 and its low 16 fractional bits.
  int ix4, sx4, iy4, sy4;
  {
    int h = hx, l = lx;
    for (int i = 0; i < ss_x; ++i) shr1(h, l);
    ix4 = (h << 16) | int(uint(l) >> 16);
    sx4 = l & 0xffff;
  }
  {
    int h = hy, l = ly;
    for (int i = 0; i < ss_y; ++i) shr1(h, l);
    iy4 = (h << 16) | int(uint(l) >> 16);
    sy4 = l & 0xffff;
  }

  sx4 += pc.alpha * (-4) + pc.beta * (-4);
  sy4 += pc.gamma * (-4) + pc.delta * (-4);
  sx4 &= ~((1 << WARP_PARAM_REDUCE_BITS) - 1);
  sy4 &= ~((1 << WARP_PARAM_REDUCE_BITS) - 1);

  int tmp[15 * 8];

  // Horizontal pass.
  for (int k = -7; k < 8; ++k) {
    const int iy = clampi(iy4 + k, 0, height - 1);
    int sx = sx4 + pc.beta * (k + 4);
    for (int l = -4; l < 4; ++l) {
      const int ix = ix4 + l - 3;
      const int offs = ((sx + (1 << (WARPEDDIFF_PREC_BITS - 1))) >>
                        WARPEDDIFF_PREC_BITS) +
                       3 * WARPEDPIXEL_PREC_SHIFTS;
      int sum = 1 << offset_bits_horiz;
      for (int m = 0; m < 8; ++m) {
        const int sample_x = clampi(ix + m, 0, width - 1);
        sum += int(ref_px[uint(iy * stride + sample_x)]) * wf[offs * 8 + m];
      }
      tmp[(k + 7) * 8 + (l + 4)] = (sum + (1 << (reduce_bits_horiz - 1))) >>
                                   reduce_bits_horiz;
      sx += pc.alpha;
    }
  }

  // Vertical pass.
  const int k_lim = min(4, int(pc.p_row) + int(pc.p_height) - i0 - 4);
  const int l_lim = min(4, int(pc.p_col) + int(pc.p_width) - j0 - 4);
  const int maxv = (1 << bd) - 1;
  for (int k = -4; k < k_lim; ++k) {
    int sy = sy4 + pc.delta * (k + 4);
    for (int l = -4; l < l_lim; ++l) {
      const int offs = ((sy + (1 << (WARPEDDIFF_PREC_BITS - 1))) >>
                        WARPEDDIFF_PREC_BITS) +
                       3 * WARPEDPIXEL_PREC_SHIFTS;
      int sum = 1 << offset_bits_vert;
      for (int m = 0; m < 8; ++m) {
        sum += tmp[(k + m + 4) * 8 + (l + 4)] * wf[offs * 8 + m];
      }
      sum = (sum + (1 << (reduce_bits_vert - 1))) >> reduce_bits_vert;
      const int v = sum - (1 << (bd - 1)) - (1 << bd);
      const uint idx = uint((i0 - int(pc.p_row) + k + 4) * int(pc.p_stride) +
                            (j0 - int(pc.p_col) + l + 4));
      pred_px[idx] = uint(v < 0 ? 0 : (v > maxv ? maxv : v));
      sy += pc.gamma;
    }
  }
}
