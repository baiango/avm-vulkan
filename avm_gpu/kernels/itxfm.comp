#version 450
// Inverse DCT, any of 4x4 / 8x8 / 16x16 / 32x32 (DCT_DCT) with reconstruction
// add.
//
// Mirrors av2/common/idct.c inv_txfm_c(): clamp_buf to bd + 8 bits, the
// inv_tx_shift pair for the size, the transposed per-pass layout, the bd + 8 /
// bd clamp ranges and highbd_clip_pixel_add. The 1D pass is the transform
// matrix itself (tx_kernel_dct2_sizeN[INV_TXFM][0]): out[k] = sum_j src[j] *
// M[j][k], which is exactly what the butterflies in idct.c evaluate. AVM's
// matrices are small (|v| <= 90), so with coefficients clamped to bd + 8 bits
// every product fits in 32 bits.

layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer Coef { int c[]; };
layout(std430, binding = 1) readonly buffer Pos { uvec2 pos[]; };
layout(std430, binding = 2) buffer Dst { uint d[]; };
layout(std430, binding = 3) readonly buffer Mat { int m[]; };

layout(push_constant) uniform PC {
  uint size_;  // 4, 8, 16 or 32
  uint bd;
  uint stride;
  uint count;
  uint shift1;
  uint shift2;
  uint pad0;
  uint pad1;
} pc;

int clampv(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

// One 1D inverse transform: dst[k] for k in [0, size), read as src[0..size).
void inv1d(int src[32], out int dst[32], int size, int shift, int lo, int hi) {
  const int add = 1 << (shift - 1);
  for (int k = 0; k < size; ++k) {
    int acc = 0;
    for (int j = 0; j < size; ++j) acc += src[j] * m[j * size + k];
    dst[k] = clampv((acc + add) >> shift, lo, hi);
  }
}

void main() {
  const uint b = gl_GlobalInvocationID.x;
  if (b >= pc.count) return;

  const int size_ = int(pc.size_);
  const int bd = int(pc.bd);
  const int mid = 1 << (bd + 7);
  const int colmax = 1 << bd;
  const uint src_off = pos[b].x;
  const uint dst_off = pos[b].y;

  int block[1024];
  int tmp[1024];

  for (int i = 0; i < size_ * size_; ++i) {
    block[i] = clampv(c[src_off + uint(i)], -mid, mid - 1);
  }

  // Pass 1: rows of the coefficient block, transposed into tmp.
  for (int j = 0; j < size_; ++j) {
    int s[32], o[32];
    for (int k = 0; k < size_; ++k) s[k] = block[j * size_ + k];
    inv1d(s, o, size_, int(pc.shift1), -mid, mid - 1);
    for (int k = 0; k < size_; ++k) tmp[k * size_ + j] = o[k];
  }
  // Pass 2: rows of tmp back into the block.
  for (int j = 0; j < size_; ++j) {
    int s[32], o[32];
    for (int k = 0; k < size_; ++k) s[k] = tmp[j * size_ + k];
    inv1d(s, o, size_, int(pc.shift2), -colmax, colmax - 1);
    for (int k = 0; k < size_; ++k) block[k * size_ + j] = o[k];
  }

  const int maxv = (1 << bd) - 1;
  for (int y = 0; y < size_; ++y) {
    for (int x = 0; x < size_; ++x) {
      const uint idx = dst_off + uint(y) * pc.stride + uint(x);
      int v = int(d[idx]) + block[y * size_ + x];
      d[idx] = uint(v < 0 ? 0 : (v > maxv ? maxv : v));
    }
  }
}
