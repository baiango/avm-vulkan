#version 450
// Inverse DCT, square and rectangular (4..32 in each dimension), DCT_DCT,
// with reconstruction add.
//
// Mirrors av2/common/idct.c inv_txfm_c(): optional NewInvSqrt2 pre-scaling for
// odd log2(w)+log2(h), clamp_buf to bd + 8 bits, the per-size inv_tx_shift
// pair, the transposed per-pass layout (row pass uses the width matrix and a
// height stride, column pass the height matrix and a width stride), the bd + 8
// / bd clamp ranges and highbd_clip_pixel_add. The 1D pass is the transform
// matrix product, which is what the idct.c butterflies evaluate.

layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer Coef { int c[]; };
layout(std430, binding = 1) readonly buffer Pos { uvec2 pos[]; };
layout(std430, binding = 2) buffer Dst { uint d[]; };
layout(std430, binding = 3) readonly buffer Mat { int m[]; };

layout(push_constant) uniform PC {
  uint w;
  uint h;
  uint bd;
  uint stride;
  uint count;
  uint shift1;
  uint shift2;
  uint sqrt2;
} pc;

const int NEW_INV_SQRT2 = 2896;
const int NEW_SQRT2_BITS = 12;

int clampv(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }

// 1D inverse: dst[k] = sum_j src[j] * M[j * n + k], rounded and clamped.
void inv1d(int src[32], out int dst[32], int n, int mat_off, int shift, int lo,
           int hi) {
  const int add = 1 << (shift - 1);
  for (int k = 0; k < n; ++k) {
    int acc = 0;
    for (int j = 0; j < n; ++j) acc += src[j] * m[mat_off + j * n + k];
    dst[k] = clampv((acc + add) >> shift, lo, hi);
  }
}

void main() {
  const uint b = gl_GlobalInvocationID.x;
  if (b >= pc.count) return;

  const int w = int(pc.w);
  const int h = int(pc.h);
  const int bd = int(pc.bd);
  const int mid = 1 << (bd + 7);
  const int colmax = 1 << bd;
  const uint src_off = pos[b].x;
  const uint dst_off = pos[b].y;
  const int wmat = 0;
  const int hmat = w * w;

  int block[1024];
  int tmp[1024];

  // Optional 1/sqrt(2) pre-scale for rectangular transforms, then clamp_buf.
  for (int i = 0; i < w * h; ++i) {
    int v = c[src_off + uint(i)];
    if (pc.sqrt2 != 0u) v = (v * NEW_INV_SQRT2 + (1 << (NEW_SQRT2_BITS - 1))) >> NEW_SQRT2_BITS;
    block[i] = clampv(v, -mid, mid - 1);
  }

  // Row pass: length w, written transposed with stride h.
  for (int j = 0; j < h; ++j) {
    int s[32], o[32];
    for (int k = 0; k < w; ++k) s[k] = block[j * w + k];
    inv1d(s, o, w, wmat, int(pc.shift1), -mid, mid - 1);
    for (int k = 0; k < w; ++k) tmp[k * h + j] = o[k];
  }
  // Column pass: length h, written back with stride w.
  for (int j = 0; j < w; ++j) {
    int s[32], o[32];
    for (int k = 0; k < h; ++k) s[k] = tmp[j * h + k];
    inv1d(s, o, h, hmat, int(pc.shift2), -colmax, colmax - 1);
    for (int k = 0; k < h; ++k) block[k * w + j] = o[k];
  }

  const int maxv = (1 << bd) - 1;
  for (int y = 0; y < h; ++y) {
    for (int x = 0; x < w; ++x) {
      const uint idx = dst_off + uint(y) * pc.stride + uint(x);
      int v = int(d[idx]) + block[y * w + x];
      d[idx] = uint(v < 0 ? 0 : (v > maxv ? maxv : v));
    }
  }
}
