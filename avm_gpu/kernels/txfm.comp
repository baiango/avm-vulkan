#version 450
// Forward integer DCT (AV2 4x4 and 8x8), one block per invocation.
//
// Mirrors avm_dsp/fwd_txfm.c exactly: same butterfly, same cospi constants,
// same DCT_CONST_BITS = 14 rounding. The C reference accumulates products in
// int64 (tran_high_t); MoltenVK reports shaderInt64 = 0, so products are formed
// with imulExtended() and the 64-bit value is carried as (hi, lo) explicitly,
// then rounded and shifted back into 32 bits.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer Src { int s[]; };
layout(std430, binding = 1) readonly buffer Pos { uint pos[]; };
layout(std430, binding = 2) writeonly buffer Out { int o[]; };

layout(push_constant) uniform PC {
  uint stride;
  uint size;   // 4 or 8
  uint count;  // number of blocks
  uint packed; // 1 = two signed 16-bit samples per word
} pc;

const int DCT_BITS = 14;

const int COSPI_4_64 = 16069;
const int COSPI_8_64 = 15137;
const int COSPI_12_64 = 13623;
const int COSPI_16_64 = 11585;
const int COSPI_20_64 = 9102;
const int COSPI_24_64 = 6270;
const int COSPI_28_64 = 3196;

// Signed 16-bit sample from a packed or widened source word.
int samp(uint i) {
  if (pc.packed == 0u) return s[int(i)];
  const uint w = uint(s[int(i >> 1u)]);
  const uint h = (i & 1u) == 0u ? (w & 0xffffu) : (w >> 16u);
  return (int(h) << 16) >> 16;
}

// (hi, lo) >> nbits, rounding half up, truncated to the low 32 bits.
int shr64_round(int hi, int lo, int nbits) {
  const uint rnd = 1u << uint(nbits - 1);
  uint ulo = uint(lo) + rnd;
  if (ulo < rnd) hi += 1;
  return (hi << uint(32 - nbits)) | int(ulo >> uint(nbits));
}

// (a * b) rounded >> nbits with a 64-bit product.
int mul_shift(int a, int b, int nbits) {
  int hi, lo;
  imulExtended(a, b, hi, lo);
  return shr64_round(hi, lo, nbits);
}

// (a * b + c * d) rounded >> nbits with 64-bit products and sum.
int mul2_shift(int a, int b, int c, int d, int nbits) {
  int h1, l1, h2, l2;
  imulExtended(a, b, h1, l1);
  imulExtended(c, d, h2, l2);
  const uint ul1 = uint(l1);
  uint lo = ul1 + uint(l2);
  int hi = h1 + h2 + (lo < ul1 ? 1 : 0);
  return shr64_round(hi, int(lo), nbits);
}

// fdct4 butterfly: returns (out0, out1, out2, out3) in output order.
ivec4 fdct4(int s0, int s1, int s2, int s3) {
  const int step0 = s0 + s3;
  const int step1 = s1 + s2;
  const int step2 = s1 - s2;
  const int step3 = s0 - s3;
  const int d0 = mul_shift(step0 + step1, COSPI_16_64, DCT_BITS);
  const int d2 = mul_shift(step0 - step1, COSPI_16_64, DCT_BITS);
  const int d1 = mul2_shift(step2, COSPI_24_64, step3, COSPI_8_64, DCT_BITS);
  const int d3 = mul2_shift(step2, -COSPI_8_64, step3, COSPI_24_64, DCT_BITS);
  return ivec4(d0, d1, d2, d3);
}

void fdct4x4(uint base, uint obase) {
  int inter[16];
  int outv[16];
  uint ip = base;

  for (int i = 0; i < 4; ++i) {
    int ih0 = samp(ip + 0 * pc.stride) * 16;
    int ih1 = samp(ip + 1 * pc.stride) * 16;
    int ih2 = samp(ip + 2 * pc.stride) * 16;
    int ih3 = samp(ip + 3 * pc.stride) * 16;
    if (i == 0 && ih0 != 0) ih0 += 1;
    const ivec4 r = fdct4(ih0, ih1, ih2, ih3);
    inter[i * 4 + 0] = r.x;
    inter[i * 4 + 1] = r.y;
    inter[i * 4 + 2] = r.z;
    inter[i * 4 + 3] = r.w;
    ip += 1;
  }

  for (int i = 0; i < 4; ++i) {
    const ivec4 r =
        fdct4(inter[i], inter[i + 4], inter[i + 8], inter[i + 12]);
    outv[i * 4 + 0] = r.x;
    outv[i * 4 + 1] = r.y;
    outv[i * 4 + 2] = r.z;
    outv[i * 4 + 3] = r.w;
  }

  for (int k = 0; k < 16; ++k) o[obase + uint(k)] = (outv[k] + 1) >> 2;
}

void fdct8x8(uint base, uint obase) {
  int inter[64];
  int outv[64];
  uint ip = base;

  for (int pass = 0; pass < 2; ++pass) {
    for (int i = 0; i < 8; ++i) {
      int s0, s1, s2, s3, s4, s5, s6, s7;
      if (pass == 0) {
        s0 = (samp(ip + 0 * pc.stride) + samp(ip + 7 * pc.stride)) * 4;
        s1 = (samp(ip + 1 * pc.stride) + samp(ip + 6 * pc.stride)) * 4;
        s2 = (samp(ip + 2 * pc.stride) + samp(ip + 5 * pc.stride)) * 4;
        s3 = (samp(ip + 3 * pc.stride) + samp(ip + 4 * pc.stride)) * 4;
        s4 = (samp(ip + 3 * pc.stride) - samp(ip + 4 * pc.stride)) * 4;
        s5 = (samp(ip + 2 * pc.stride) - samp(ip + 5 * pc.stride)) * 4;
        s6 = (samp(ip + 1 * pc.stride) - samp(ip + 6 * pc.stride)) * 4;
        s7 = (samp(ip + 0 * pc.stride) - samp(ip + 7 * pc.stride)) * 4;
        ip += 1;
      } else {
        s0 = inter[i + 0 * 8] + inter[i + 7 * 8];
        s1 = inter[i + 1 * 8] + inter[i + 6 * 8];
        s2 = inter[i + 2 * 8] + inter[i + 5 * 8];
        s3 = inter[i + 3 * 8] + inter[i + 4 * 8];
        s4 = inter[i + 3 * 8] - inter[i + 4 * 8];
        s5 = inter[i + 2 * 8] - inter[i + 5 * 8];
        s6 = inter[i + 1 * 8] - inter[i + 6 * 8];
        s7 = inter[i + 0 * 8] - inter[i + 7 * 8];
      }

      const int x0 = s0 + s3;
      const int x1 = s1 + s2;
      const int x2 = s1 - s2;
      const int x3 = s0 - s3;

      outv[i * 8 + 0] = mul_shift(x0 + x1, COSPI_16_64, DCT_BITS);
      outv[i * 8 + 4] = mul_shift(x0 - x1, COSPI_16_64, DCT_BITS);
      outv[i * 8 + 2] = mul2_shift(x2, COSPI_24_64, x3, COSPI_8_64, DCT_BITS);
      outv[i * 8 + 6] = mul2_shift(x2, -COSPI_8_64, x3, COSPI_24_64, DCT_BITS);

      const int u0 = mul_shift(s6 - s5, COSPI_16_64, DCT_BITS);
      const int u1 = mul_shift(s6 + s5, COSPI_16_64, DCT_BITS);

      const int y0 = s4 + u0;
      const int y1 = s4 - u0;
      const int y2 = s7 - u1;
      const int y3 = s7 + u1;

      outv[i * 8 + 1] = mul2_shift(y0, COSPI_28_64, y3, COSPI_4_64, DCT_BITS);
      outv[i * 8 + 3] = mul2_shift(y2, COSPI_12_64, y1, -COSPI_20_64, DCT_BITS);
      outv[i * 8 + 5] = mul2_shift(y1, COSPI_12_64, y2, COSPI_20_64, DCT_BITS);
      outv[i * 8 + 7] = mul2_shift(y3, COSPI_28_64, y0, -COSPI_4_64, DCT_BITS);
    }
    for (int k = 0; k < 64; ++k) inter[k] = outv[k];
  }

  for (int k = 0; k < 64; ++k) o[obase + uint(k)] = outv[k] / 2;
}

void main() {
  const uint b = gl_GlobalInvocationID.x;
  if (b >= pc.count) return;
  if (pc.size == 4u) {
    fdct4x4(pos[b], b * 16u);
  } else {
    fdct8x8(pos[b], b * 64u);
  }
}
