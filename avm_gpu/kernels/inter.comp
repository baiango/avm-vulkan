#version 450
// Inter prediction: 8-tap separable subpel convolution, one invocation per
// output pixel.
//
// Mirrors avm_dsp/avm_convolve.c avm_highbd_convolve8_c() for any
// x_step_q4 / y_step_q4 (unscaled reference is step 16):
//   horizontal: sum(fh[k] * src[.. x + k - 3]) -> clip(ROUND_POWER_OF_TWO(., 7))
//   vertical  : sum(fv[k] * temp[.. y + k - 3]) -> clip(ROUND_POWER_OF_TWO(., 7))
// with AVM's clip_pixel_highbd between and after the two passes.

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) readonly buffer Src { uint s[]; };
layout(std430, binding = 1) readonly buffer Filt { int f[]; };
layout(std430, binding = 2) writeonly buffer Dst { uint d[]; };
// High-precision compound buffer (only used when compound != 0).
layout(std430, binding = 3) buffer Conv { uint conv[]; };

layout(push_constant) uniform PC {
  uint src_stride;
  uint dst_stride;
  uint sx;
  uint sy;
  uint w;
  uint h;
  uint bd;
  uint x0;      // horizontal subpel position, 0..15
  uint y0;      // vertical subpel position, 0..15
  uint x_step;  // 16 for an unscaled reference
  uint y_step;
  uint sr;      // 1 = av2_highbd_convolve_2d_sr_c() rounding
  uint round0;
  uint round1;
  uint fvo;     // offset of the vertical filter table in units of 8 taps
  uint sb;      // subpel position bits: 4 (1/16) or 10 (1/1024, scaled refs)
  uint compound;    // 1 = av2_highbd_convolve_2d_scale_c() with is_compound
  uint do_average;  // second reference: average with the conv buffer
  uint conv_stride;
  uint uneven;      // weighted average with fwd/bck (else (a + b) >> 1)
  int fwd;
  int bck;
} pc;

int clipval(int v, int maxv) { return v < 0 ? 0 : (v > maxv ? maxv : v); }

void main() {
  const int x = int(gl_GlobalInvocationID.x);
  const int y = int(gl_GlobalInvocationID.y);
  if (x >= int(pc.w) || y >= int(pc.h)) return;

  const int maxv = (1 << int(pc.bd)) - 1;
  const int ss = int(pc.src_stride);
  const int ds = int(pc.dst_stride);
  const int sxp = int(pc.sx);
  const int syp = int(pc.sy);
  const int sb = int(pc.sb);
  const int fb = sb - 4;  // filter index = subpel phase >> fb
  const int xq = int(pc.x0) + x * int(pc.x_step);
  const int yq = int(pc.y0) + y * int(pc.y_step);
  const int base_x = xq >> sb;
  const int base_y = yq >> sb;
  const int fh = ((xq >> fb) & 15) * 8;
  const int fv = int(pc.fvo) + ((yq >> fb) & 15) * 8;

  const int sr = int(pc.sr);
  const int r0 = int(pc.round0);
  const int r1 = int(pc.round1);
  const int hbias = 1 << (int(pc.bd) + 6);          // single-ref sr path
  const int vbias = 1 << (int(pc.bd) + 14 - r0);

  int temp[8];
  for (int ky = 0; ky < 8; ++ky) {
    const int row = syp + base_y + ky - 3;
    int sum = sr != 0 ? hbias : 0;
    for (int kx = 0; kx < 8; ++kx) {
      const int col = sxp + base_x + kx - 3;
      sum += f[fh + kx] * int(s[row * ss + col]);
    }
    // convolve8 clips between the passes; the sr path keeps a 16-bit
    // intermediate and rounds by round_0 instead.
    temp[ky] = sr != 0 ? (sum + (1 << (r0 - 1))) >> r0
                       : clipval((sum + 64) >> 7, maxv);
  }

  int vsum = sr != 0 ? vbias : 0;
  for (int ky = 0; ky < 8; ++ky) vsum += f[fv + ky] * temp[ky];
  if (sr == 0) {
    d[y * ds + x] = uint(clipval((vsum + 64) >> 7, maxv));
    return;
  }
  // av2_highbd_convolve_2d_sr_c(): round by round_1, subtract the bias the
  // two rounded passes injected, then round by the remaining bits.
  const int bits = 14 - r0 - r1;
  if (pc.compound != 0u) {
    /* av2_highbd_convolve_2d_scale_c() with conv_params->is_compound: the
     * rounded vertical sum goes to the CONV_BUF_TYPE buffer (uint16), and the
     * second reference averages it with its own sum, subtracts the round
     * offset and rounds by the remaining bits (ROUND_POWER_OF_TWO, i.e.
     * +half then an arithmetic shift, not away from zero). */
    const int c = ((vsum + (1 << (r1 - 1))) >> r1) & 0xffff;
    const int offset_bits = int(pc.bd) + 14 - r0;
    const uint cidx = uint(y) * pc.conv_stride + uint(x);
    if (pc.do_average == 0u) {
      conv[cidx] = uint(c);
      return;
    }
    int tmp = int(conv[cidx]);
    if (pc.uneven != 0u) {
      tmp = (tmp * pc.fwd + c * pc.bck) >> 4;  // DIST_PRECISION_BITS
    } else {
      tmp = (tmp + c) >> 1;
    }
    tmp -= (1 << (offset_bits - r1)) + (1 << (offset_bits - r1 - 1));
    if (bits > 0) tmp = (tmp + (1 << (bits - 1))) >> bits;
    d[y * ds + x] = uint(clipval(tmp, maxv));
    return;
  }
  int res = ((vsum + (1 << (r1 - 1))) >> r1) -
            ((1 << (int(pc.bd) + 14 - r0 - r1)) +
             (1 << (int(pc.bd) + 13 - r0 - r1)));
  if (bits > 0) {
    const int rb = 1 << (bits - 1);
    res = res < 0 ? -((-res + rb) >> bits) : ((res + rb) >> bits);
  }
  d[y * ds + x] = uint(clipval(res, maxv));
}
